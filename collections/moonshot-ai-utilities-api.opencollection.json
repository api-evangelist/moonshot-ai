{
  "opencollection": "1.0.0",
  "info": {
    "name": "Moonshot AI Batch Utilities API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Utilities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Estimate Token Count",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.moonshot.ai/v1/tokenizers/estimate-token-count",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Estimates the number of tokens that would be used for a given set of messages and model. The input structure is almost identical to that of chat completion."
        }
      ]
    }
  ],
  "bundled": true
}